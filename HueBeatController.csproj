<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tmp\**;tmp\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HueApi.Entertainment" Version="3.3.0" />
    <!-- Private comparison assets/backups must not enter build or publish output. -->
    <Content Remove="data\offline-backups\**;data\offline-projects\**" />
    <None Remove="data\offline-backups\**;data\offline-projects\**" />
  </ItemGroup>
</Project>
